__pycache__/
*.py[cod]
*.pyo
.env
*.egg-info/
dist/
build/
.venv/
venv/
*.log

# Notebooks: regenerowalne wyjścia (figury, ipynb pairing)
notebooks/*.png
notebooks/*.ipynb

# --- Claude Code Session System ---
# Odkomentuj jeśli nie chcesz commitować stanu sesji:
# last_session.md
# last_session.archive.md
*.backup_*

# --- Generated reporting media w artifacts/ ---
# Figury/animacje są inline'owane base64 do docs/report.html (embed-resources) → redundantne w repo.
# *.parquet / *.sqlite / artifacts_manifest.json (deliverables) zostają trackowane (planowo git-lfs).
artifacts/*.png
artifacts/*.webm
artifacts/*.gif

# --- Quarto build artifacts ---
# Figury są inline'owane do docs/*.html (embed-resources), więc źródła build nie są commitowane.
.quarto/
src/driftscope/reporting/figs/
src/driftscope/reporting/report.html
src/driftscope/reporting/report_files/
src/driftscope/reporting/*_files/
